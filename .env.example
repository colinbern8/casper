# Copy to .env (never commit .env). Production-required settings are marked REQUIRED.

# --- Sign-in ----------------------------------------------------------
# Everyone signs in with a Google Workspace account in this domain.
DISTRICT_DOMAIN="htsdnj.org"
# Shown in page headers and on printed slips.
# DISTRICT_NAME="Hamilton Township School District"
# 2 to 8 letters or digits that start every ticket number (HTSD-2026-0001).
# TICKET_PREFIX="HTSD"
# REQUIRED in production. Google OAuth "Web application" client ID (see README, "Set up Google sign-in").
GOOGLE_CLIENT_ID=""
# REQUIRED in production. Long random string used to sign session cookies.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""
# REQUIRED in production. Comma-separated. These people are always admins and can add everyone else
# from the Admin page. They cannot be removed in the app.
ADMIN_EMAILS=""

# --- Development only -------------------------------------------------
# Lets you sign in as any district address without Google. The server REFUSES to start
# with this on in production. Leave off anywhere real people can reach.
DEV_LOGIN=false
# Sample tickets plus demo accounts (demo.student/teacher/tech/admin@DISTRICT_DOMAIN) for the dev sign-in panel.
DEMO_MODE=false

# --- Student request limit --------------------------------------------
# How many unresolved requests one student may have at once (1 to 10). A student at the limit
# gets an automatic message to contact the main office or a technician. A technician can allow
# one more on a student's open request, for example for a loaner problem.
# STUDENT_OPEN_TICKET_LIMIT=1

# --- Storage and alerts -----------------------------------------------
# Tickets and roles are saved here (tickets.json, users.json). Put this on a persistent disk.
DATA_DIR="./data"
# Optional Slack/Teams incoming webhook. Alerts for Priority 1 and 2 staff tickets (never students).
# NOTIFY_WEBHOOK_URL=""

# --- Hosting ----------------------------------------------------------
PORT=3000
# Number of reverse proxies in front of the app (1 for most hosts) so rate limits see real client IPs.
# TRUST_PROXY=1
