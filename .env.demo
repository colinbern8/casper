# Demo settings: sign-in buttons for Student/Teacher/Technician/Admin plus fictional sample data.
# Local use only. The server refuses to start with these on in production.
DEV_LOGIN=true
DEMO_MODE=true
DISTRICT_DOMAIN=demo.example.org
ADMIN_EMAILS=demo.admin@demo.example.org
# Demo data lives apart from development data. `npm run demo:reset` deletes it; the next start re-seeds it.
DATA_DIR=./data-demo
